# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# XML files
[*.xml]
indent_size = 4

# Android resource files
[{**/res/**/*.xml,**/res/values/*.xml}]
file_type = xml
indent_size = 4
